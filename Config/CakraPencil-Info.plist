<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- .occa project file and .occasym symbol set (Save / Open / Export) on iPad and Mac. Other keys are generated by Xcode (INFOPLIST_KEY_*). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>id.cakrapencil.project</string>
			<key>UTTypeDescription</key>
			<string>OCCA Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>occa</string>
					<string>coca</string>
					<string>cpencil</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-occa</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>id.cakrapencil.symbolset</string>
			<key>UTTypeDescription</key>
			<string>OCCA Symbol Set</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>occasym</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-occasym</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Fieldwork (iPad): photos for field notes, and GPS track recording that keeps running with the screen off. -->
	<key>NSCameraUsageDescription</key>
	<string>OCCA uses the camera to take photos for field notes. The photos stay in your project on this device.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OCCA Project</string>
