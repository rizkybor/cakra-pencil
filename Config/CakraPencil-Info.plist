			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>id.cakrapencil.project</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OCCA Symbol Set</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>id.cakrapencil.symbolset</string>
			</array>
		</dict>
	</array>
